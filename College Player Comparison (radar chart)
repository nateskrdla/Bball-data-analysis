import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.patches import Patch

# Load the percentile data
file_path = "trank_player_percentile_data.csv"
percentile_data = pd.read_csv(file_path)

# Select players and columns to plot
season = "2024-25"
players = ["Labaron Philon", "V.J. Edgecombe"]
columns_to_plot = ['3P%', '2P%', 'RIM%', 'FTr', 'eFG%', 'ORtg', 'BLK%', 'STL%', 'DRB%', 'ORB%', 'TOV%', 'AST%', 'USG%']


values_list = []
for player in players:
    data = percentile_data[percentile_data['Player'] == player]
    if not data.empty:
        values = data[columns_to_plot].iloc[0].values / 100  # Normalize percentiles to 0-1
        values_list.append(values)
    else:
        print(f"{player} not found in the dataset.")
        values_list.append([0] * len(columns_to_plot))

        if not data.empty:
            values = data[columns_to_plot].iloc[0].values
            values_list.append(values)
        else:
            print(f"{player} not found in {season} data.")
            values_list.append([0] * len(columns_to_plot))
    
    angles = np.linspace(0, 2 * np.pi, len(columns_to_plot), endpoint=False).tolist()
    angles += [angles[0]]
    
    fig, ax = plt.subplots(subplot_kw=dict(polar=True), figsize=(8, 8), facecolor='#f3f6f4')
    ax.set_theta_offset(np.pi / 2)
    ax.set_theta_direction(-1)
    ax.set_xticks(angles[:-1])
    ax.set_xticklabels(columns_to_plot, color='black', size=10)
    ax.set_facecolor('#eeeeee')
    
    colors = ["red", "darkgreen"]
    for i, (player, values) in enumerate(zip(players, values_list)):
        values = np.append(values, values[0])
        ax.plot(angles, values, linewidth=1, linestyle='solid', label=player, color=colors[i])
        ax.fill(angles, values, alpha=0.4, color=colors[i])
        for angle, value in zip(angles, values[:-1]):
            ax.plot([angle, angle], [0, value], color='black', linewidth=1, linestyle='solid')
            bbox_props = dict(boxstyle="square,pad=0.2", fc="white", ec="black", lw=0.5)
            ax.text(angle, value, f"{value * 100:.1f}%", color=colors[i], ha='center', va='bottom', bbox=bbox_props, fontsize=8)
    
    ax.set_ylim(0, 1)  # Set y-axis from 0 to 1
    for i in [0.25, 0.5, 0.75, 1.0]:
        ax.plot(angles, [i] * len(columns_to_plot) + [i], color='black', linewidth=1, linestyle='dotted')
    
    ax.set_yticklabels([])
    ax.set_yticks([])
    ax.set_title(f"{players[0]} vs. {players[1]} Player Profile Comparison {season}", size=12, color='black', y=1.1)

    legend_elements = [Patch(facecolor='red', edgecolor='black', label=players[0]),
                       Patch(facecolor='darkgreen', edgecolor='black', label=players[1])]
    ax.legend(handles=legend_elements, loc='lower left', fontsize='small')
    # Add data source text at the bottom
    plt.figtext(0.5, -0.01, "Data Source: basketball-reference.com", 
            ha='center', fontsize=7, color='black')
    fig.suptitle("Player Percentile Rankings", fontsize=10, y=.92)
    plt.tight_layout()
    plt.show()
